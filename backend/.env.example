# =============================================================
# Server configuration
# =============================================================
NODE_ENV=development
# Server
PORT=8080
# Use 0.0.0.0 to expose the API on cloud deployments
HOST=0.0.0.0
# API version prefix (e.g. /api/v1)
API_VERSION=v1

# =============================================================
# Database driver
#
# Development (Windows PC, no PostgreSQL install required):
#   DB_DRIVER=sqlite            -> embedded PostgreSQL (PGlite), data in backend/.localdb
#
# Production / cloud (real PostgreSQL):
#   DB_DRIVER=postgres
#   DATABASE_URL=postgres://user:password@host:5432/repair_workshop
#   (legacy alternative: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, DB_SSL)
#
# Driver is inferred when DB_DRIVER is unset:
#   - DATABASE_URL starts with postgres://  -> postgres
#   - otherwise                             -> sqlite (local dev)
# =============================================================
DB_DRIVER=sqlite
# SQLITE_PATH=.localdb

DB_HOST=localhost
DB_PORT=5432
DB_NAME=repair_workshop
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# =============================================================
# JWT Authentication
# =============================================================
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================
# Firebase Cloud Messaging
# =============================================================
FCM_SERVER_KEY=
FCM_PROJECT_ID=
# Path to service account JSON for full FCM v1 API
FCM_SERVICE_ACCOUNT_PATH=

# =============================================================
# SMS / WhatsApp providers (integration-ready)
# =============================================================
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# =============================================================
# CORS - comma separated list of allowed dashboard origins
# =============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================
# Logging
# =============================================================
LOG_LEVEL=info